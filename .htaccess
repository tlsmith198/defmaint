# ADMI Maintenance System - Apache configuration (GoDaddy cPanel / shared hosting)
#
# If this file ever causes a 403 or 500 on a new host, rename it to .htaccess.bak,
# confirm the app loads, then re-introduce the blocks below one at a time.

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
DirectoryIndex index.php

# Do not serve source, config, SQL or log files directly.
<FilesMatch "\.(sql|md|log|ini|sample|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block the private folders whether the app sits at the docroot or in a subfolder.
RedirectMatch 403 (?i)/(config|sql|includes|tmp)/

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>
